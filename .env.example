# Clé API TMDB (gratuite) : https://www.themoviedb.org/settings/api
# Peut aussi être saisie dans l'application (Profil > Paramètres) une fois connecté en admin.
TMDB_API_KEY=

# Port d'écoute de l'application
PORT=3000

# Langue des métadonnées TMDB (fr-FR, en-US, ...)
TMDB_LANGUAGE=fr-FR

# Dossier de données (base SQLite). Dans Docker, laisser /data.
DATA_DIR=/data
